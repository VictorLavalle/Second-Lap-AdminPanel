# Second Lap Admin Panel — environment template.
# Copy to .env.local and fill real values. Secrets live ONLY in the environment.

# Backend base URL the BFF (Route Handlers) talks to, server-side.
BACKEND_URL=http://localhost:8080/api/v1

# Backend origin used in the Content-Security-Policy img-src (for product images).
BACKEND_PUBLIC_ORIGIN=http://localhost:8080

# 32-byte key (base64) used to AES-256-GCM encrypt the admin Basic credentials
# stored inside the httpOnly session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# 32-byte key (base64) used to HMAC-sign the session cookie so the edge
# middleware can verify it without Node crypto. Generate the same way as above.
SESSION_SIGNING_SECRET=
